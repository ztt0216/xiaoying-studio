# 复制为 .env 后按需修改（docker compose 会自动读取）。以下均为本地演示用的非敏感默认值。
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=studio
MYSQL_PASSWORD=studio
# 宿主机端口
WEB_PORT=3000
BACKEND_PORT=8080
MYSQL_PORT=3307
# 模拟配置：每阶段耗时（毫秒）与失败阶段（NONE / ASSET_CHECK / GENERATE / FINALIZE）
SIM_STEP_DELAY_MS=3000
SIM_FAIL_STAGE=NONE
# 后台工作线程数（1 = 任务排队串行；>1 = 并行）
WORKER_THREADS=2
